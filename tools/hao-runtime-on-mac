#!/usr/bin/env python3
"""hao-runtime-on-mac ROOT X86 [DIR]: make the payload's Apple-derived files from Apple's own, on the user's Mac.

DIR is an extracted hao-runtime-VERSION-public archive (default: the folder above this script). ROOT is the release's
System root (read-only mount of the IPSW's system image), X86 its x86_64 dyld shared cache folder. Writes
DIR/payload/embed/stubs/ (each program's stub, filled from embed/skeletons) and DIR/payload/replace/dyld, then checks
every file payload-manifest.json lists (AOT caches may be absent: they are made after the first boot) and that
DIR/payload holds nothing else: no file the manifest does not list, no symbolic link or special file.
Each output is written to a new file in a private directory and renamed into place; no output path is followed
through a symbolic link. Runs as an ordinary user (it refuses root): nothing it does needs privileges.
Needs Python 3.12 or later and codesign; no compiler, linker or Xcode. Exit 0 only when every sha256 matches and
nothing else is there.
"""
import hashlib, json, os, shutil, stat, struct, subprocess, sys, tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import hao_fat


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for b in iter(lambda: f.read(1 << 20), b''):
            h.update(b)
    return h.hexdigest()


HASHES = {1: 'sha1', 2: 'sha256', 3: 'sha256', 4: 'sha384'}


def trim_signature(data, want):
    """A thin Mach-O DATA, signed ad hoc, with its signature's reserved space cut to WANT bytes and its code-page hashes
    refreshed (codesign reserves more on some macOS versions; the signature itself is the same). None if not possible."""
    d = bytearray(data)
    if d[:4] != b'\xcf\xfa\xed\xfe':
        return None
    count, at, sig, linkedit = struct.unpack_from('<I', d, 16)[0], 32, None, None
    for _ in range(count):
        cmd, size = struct.unpack_from('<II', d, at)
        if cmd == 0x1d:
            sig = at
        elif cmd == 0x19 and d[at + 8:at + 24].rstrip(b'\0') == b'__LINKEDIT':
            linkedit = at
        at += size
    if sig is None or linkedit is None:
        return None
    off, size = struct.unpack_from('<II', d, sig + 8)
    magic, length, n = struct.unpack_from('>III', d, off)
    if magic != 0xfade0cc0 or off + size != len(d) or want < length or want > size:
        return None
    fileoff = struct.unpack_from('<Q', d, linkedit + 40)[0]
    filesize = off + want - fileoff
    struct.pack_into('<Q', d, linkedit + 32, (filesize + 0x3fff) & ~0x3fff)
    struct.pack_into('<Q', d, linkedit + 48, filesize)
    struct.pack_into('<I', d, sig + 12, want)
    del d[off + want:]
    for i in range(n):
        slot, blob = struct.unpack_from('>II', d, off + 12 + i * 8)
        if slot != 0 and not 0x1000 <= slot < 0x1005:
            continue
        cd = off + blob
        if struct.unpack_from('>I', d, cd)[0] != 0xfade0c02:
            return None
        hashes, _, _, pages, limit = struct.unpack_from('>5I', d, cd + 16)
        hsize, kind, _, exponent = d[cd + 36:cd + 40]
        if limit != off or kind not in HASHES or not exponent:
            return None
        page = 1 << exponent
        for q in range(pages):
            d[cd + hashes + q * hsize:cd + hashes + (q + 1) * hsize] = \
                hashlib.new(HASHES[kind], d[q * page:min((q + 1) * page, limit)]).digest()[:hsize]
    return bytes(d)


def pin(data, want_sha):
    """DATA, or the same file with the x86_64 slice's signature reservation at the size whose bytes have WANT_SHA."""
    if hashlib.sha256(data).hexdigest() == want_sha:
        return data
    parts = hao_fat.slices(data)
    x86 = [p for c, _, p in parts or [] if c == hao_fat.CPU_X86_64]
    if len(x86) != 1:
        return data
    mo = x86[0]
    ncmds = struct.unpack_from('<I', mo, 16)[0]
    at, off = 32, None
    for _ in range(ncmds):
        cmd, size = struct.unpack_from('<II', mo, at)
        if cmd == 0x1d:
            off = struct.unpack_from('<I', mo, at + 8)[0]
        at += size
    if off is None:
        return data
    length = struct.unpack_from('>I', mo, off + 4)[0]
    for want in ((length + 15) & ~15, ((length + 15) & ~15) + 16, ((length + 15) & ~15) + 32):
        t = trim_signature(mo, want)
        if t is None:
            continue
        out = t if len(parts) == 1 else hao_fat.replace_slice(data, hao_fat.CPU_X86_64, t)
        if hashlib.sha256(out).hexdigest() == want_sha:
            return out
    return data


def real_dir(top, rel):
    """TOP/REL, made a directory if missing, after checking that neither it nor a directory between TOP and it is a
    symbolic link or anything but a directory."""
    p = top
    for part in rel.split('/'):
        p = os.path.join(p, part)
        if not os.path.lexists(p):
            os.mkdir(p, 0o755)
        if not stat.S_ISDIR(os.lstat(p).st_mode):
            sys.exit('hao-runtime-on-mac: %s is a symbolic link or not a directory' % p)
    return p


def publish(data, dst, mode, work):
    """DATA to DST: written to a new file in WORK (created exclusively, in a directory only this user can open),
    then renamed over DST, so DST is replaced, never written through (a symbolic link there is replaced, not
    followed)."""
    fd, tmp = tempfile.mkstemp(dir=work)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
        os.fchmod(f.fileno(), mode)
    os.replace(tmp, dst)


def inventory(pay, files):
    """Why DIR/payload is not exactly what payload-manifest.json lists: a file it does not list, a symbolic link or
    special file, a listed file missing (not an AOT cache: made after the first boot) or changed; (problems, matching,
    AOT caches listed)."""
    bad, ok, later, seen = [], 0, 0, set()
    for base, dirs, names in os.walk(pay):
        for n in sorted(dirs + names):
            p = os.path.join(base, n)
            rel = os.path.relpath(p, pay)
            st = os.lstat(p)
            if stat.S_ISDIR(st.st_mode) or rel == 'payload-manifest.json':
                continue
            if not stat.S_ISREG(st.st_mode):
                bad.append('%s: %s' % (rel, 'a symbolic link' if stat.S_ISLNK(st.st_mode) else 'not a regular file'))
            elif rel not in files:
                bad.append('%s: not in payload-manifest.json' % rel)
            else:
                seen.add(rel)
    for rel, want in sorted(files.items()):
        if rel.startswith('root/usr/lib/hao/aot/'):
            later += 1
            if rel not in seen:
                continue
        if rel not in seen:
            bad.append('%s: missing' % rel)
        elif sha256(os.path.join(pay, rel)) != want:
            bad.append('%s: sha256 differs' % rel)
        else:
            ok += 1
    return bad, ok, later


def main(argv):
    if len(argv) not in (3, 4):
        sys.exit(__doc__.strip().split('\n\n')[0])
    if os.geteuid() == 0:
        sys.exit('hao-runtime-on-mac: run it as an ordinary user, not as root (it needs no privileges)')
    root, x86 = (os.path.abspath(a) for a in argv[1:3])
    top = os.path.abspath(argv[3] if len(argv) == 4 else os.path.join(os.path.dirname(os.path.abspath(__file__)), '..'))
    pay = os.path.join(top, 'payload')
    for p in (pay, os.path.join(pay, 'payload-manifest.json')):
        if os.path.islink(p):
            sys.exit('hao-runtime-on-mac: %s is a symbolic link' % p)
    manifest = json.load(open(os.path.join(pay, 'payload-manifest.json')))
    embed = json.load(open(os.path.join(pay, 'embed', 'manifest.json')))
    for p, what in ((root, 'ROOT'), (x86, 'X86'), (os.path.join(top, 'build', 'hao-stub'), 'build/hao-stub'),
                    (os.path.join(pay, 'embed', 'skeletons'), 'payload/embed/skeletons')):
        if not os.path.exists(p):
            sys.exit('hao-runtime-on-mac: %s not found: %s' % (what, p))
    work = tempfile.mkdtemp(prefix='.on-mac-', dir=top)
    try:
        lst = os.path.join(work, 'programs')
        with open(lst, 'w') as f:
            f.write(''.join(os.path.join(root, e['path']) + '\n' for e in embed['files']))
        out = os.path.join(work, 'embed')
        drop = os.path.join(work, 'dropped-constraints')   # the payload build's decision, from its manifest
        with open(drop, 'w') as f:
            f.write(''.join(e['path'] + '\n' for e in embed['files'] if e.get('constraints', {}).get('dropped')))
        cmd = [sys.executable, '-I', os.path.join(top, 'tools', 'hao-embed'), '--stub', os.path.join(top, 'build', 'hao-stub'),
               '--stubs', out, '--root', root, '--x86-cache', x86, '--skeletons', os.path.join(pay, 'embed', 'skeletons'),
               '--require', 'sbin/launchd', '--require', 'usr/libexec/xpcproxy', '--allow-dropped-constraints', drop,
               '--list', lst]
        with open(os.path.join(work, 'embed.log'), 'w') as log:
            rc = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT).returncode
        if rc != 0:
            lines = open(os.path.join(work, 'embed.log')).readlines()
            fails = [l for l in lines if l.startswith('fail')]
            sys.stderr.write(''.join(fails[:10] or lines[-5:]))
            sys.exit('hao-runtime-on-mac: hao-embed failed (exit %d, %d programs)' % (rc, len(fails)))
        stubs = real_dir(pay, 'embed/stubs')
        stage = os.path.join(work, 'stage')
        os.mkdir(stage, 0o700)
        pinned = 0
        for n in sorted(os.listdir(os.path.join(out, 'stubs'))):
            src, dst = os.path.join(out, 'stubs', n), os.path.join(stubs, n)
            want = manifest['files'].get('embed/stubs/' + n)
            data = open(src, 'rb').read()
            fixed = pin(data, want) if want else data
            pinned += fixed is not data
            publish(fixed, dst, os.stat(src).st_mode & 0o777, stage)
        if 'replace/dyld' not in manifest['files']:
            return finish(pay, manifest, pinned)
        replace = real_dir(pay, 'replace')
        made = os.path.join(work, 'dyld')
        rc = subprocess.run([sys.executable, '-I', os.path.join(top, 'tools', 'dyld-ignition-fix.py'),
                             os.path.join(root, 'usr/lib/dyld'), made]).returncode
        if rc != 0:
            sys.exit('hao-runtime-on-mac: dyld-ignition-fix.py failed (exit %d)' % rc)
        if not os.path.isfile(made):
            sys.exit('hao-runtime-on-mac: dyld-ignition-fix.py found this dyld not affected, but the manifest lists replace/dyld')
        want = manifest['files'].get('replace/dyld')
        data = open(made, 'rb').read()
        fixed = pin(data, want) if want else data
        pinned += fixed is not data
        publish(fixed, os.path.join(replace, 'dyld'), os.stat(made).st_mode & 0o777, stage)
        return finish(pay, manifest, pinned)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def finish(pay, manifest, pinned):
    if pinned:
        print('hao-runtime-on-mac: %d files signed with a larger reservation than the pinned one, trimmed to it' % pinned)
    bad, ok, later = inventory(pay, manifest['files'])
    for b in bad[:20]:
        print('hao-runtime-on-mac: %s' % b, file=sys.stderr)
    print('hao-runtime-on-mac: %d files match payload-manifest.json, %d differ or are missing; %d AOT caches are made '
          'after the first boot' % (ok, len(bad), later))
    return 1 if bad else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
