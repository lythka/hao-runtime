#!/usr/bin/env python3
"""List signed ARM apps and their main-executable hashes in one directory.

The hash identifies changes to executable bytes. Resource-only changes are outside
the inventory. Platform launch assessment still belongs to LaunchServices.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import plistlib
import stat
import subprocess
import sys
from xml.parsers.expat import ExpatError

from hao_macho import CPU_ARM64, CPU_X86_64, header_slices


def regular_file(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    stream = os.fdopen(descriptor, "rb")
    if not stat.S_ISREG(os.fstat(descriptor).st_mode):
        stream.close()
        raise ValueError(f"{path} is not a regular file")
    return stream


def inspect(bundle):
    contents = bundle / "Contents"
    macos = contents / "MacOS"
    if any(path.is_symlink() for path in (bundle, contents, macos)):
        raise ValueError("symbolic link in application path")
    with regular_file(contents / "Info.plist") as stream:
        try:
            info = plistlib.load(stream)
        except (AttributeError, OverflowError, RecursionError, IndexError, TypeError) as exc:
            raise ValueError("invalid Info.plist") from exc
    name = info.get("CFBundleExecutable") if isinstance(info, dict) else None
    if not isinstance(name, str) or name in ("", ".", "..") or Path(name).name != name:
        raise ValueError("invalid CFBundleExecutable")
    executable = macos / name
    with regular_file(executable) as stream:
        before = os.fstat(stream.fileno())
        if not before.st_mode & 0o111:
            raise ValueError("main program has no executable permission")
        slices = header_slices(stream.read(4096))
        if not any(cpu == CPU_ARM64 for cpu, _, _ in slices):
            return None
        architectures = []
        for cpu, subtype, _ in slices:
            if cpu == CPU_ARM64:
                architectures.append("arm64e" if subtype == 2 else "arm64")
            elif cpu == CPU_X86_64:
                architectures.append("x86_64h" if subtype == 8 else "x86_64")
        stream.seek(0)
        subprocess.run(["/usr/bin/codesign", "--verify", "--strict", "--all-architectures", str(bundle)],
                       capture_output=True, check=True)
        digest = hashlib.sha256()
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
        after = executable.stat(follow_symlinks=False)
        if (before.st_dev, before.st_ino, before.st_ctime_ns) != (after.st_dev, after.st_ino, after.st_ctime_ns):
            raise ValueError("main executable changed during discovery")
    return {"bundle": str(bundle), "architectures": architectures, "executable_sha256": digest.hexdigest()}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory", type=Path)
    args = parser.parse_args()
    if not args.directory.is_dir():
        parser.error("inventory root must be a directory")
    rows = []
    for bundle in sorted(args.directory.resolve(strict=True).glob("*.app")):
        try:
            record = inspect(bundle)
        except (OSError, ValueError, ExpatError, plistlib.InvalidFileException, subprocess.CalledProcessError) as exc:
            print(f"{bundle}: {exc}", file=sys.stderr)
            continue
        if record:
            rows.append(record)
    print(json.dumps(rows, indent=2))


if __name__ == "__main__":
    main()
