#!/usr/bin/env python3
"""hao-trust-list ROOT [LIST] > trusted-cdhashes
       hao-trust-list --stubs EMBED_DIR TRUSTED ROOT > stub-identities
       hao-trust-list --cdhash FILE...

The cdhash list that lets hao (src/guest_sig.c) recognise a release's
Apple-signed arm64-only code without a daemon: the programs it runs, and the
guest libraries they load (library validation, src/libval.c: an x86_64 kernel
cannot hold their 16 KiB-page signatures, so hao decides). One line per file:

    <40 hex: cdhash of the arm64 slice's best CodeDirectory>  <path under ROOT>

for every arm64-only LC_MAIN executable under ROOT (as tools/hao-embed --scan)
and every arm64-only dylib or bundle (MH_DYLIB, MH_BUNDLE: a guest image),
or the paths in LIST (one per line, absolute or relative to ROOT), whose arm64
slice (the one hao runs: plain arm64e > arm64e.* > arm64) satisfies
`codesign --verify --strict --ignore-resources -R='anchor apple'` here, at
image build, where trustd runs (bundle resources are not code: neither the
kernel nor hao checks them at exec). A program that does not verify is left out (reported on stderr):
at run time hao then authenticates its CMS by the slower routes.

The cdhash is computed as xnu does (cs_validate_csblob: the CodeDirectory of
highest hash rank, SHA-1 < SHA-256/20 < SHA-256 < SHA-384, hashed with its own
type, first 20 bytes). hao-image-payload installs the list as
usr/lib/hao/trusted-cdhashes; hao reads it only if root owns it and its
directories and nobody else can write them. --cdhash prints the cdhash of
each FILE's arm64 slice (tests use it).

--stubs lists the stubs that tools/hao-embed made for Apple programs (EMBED_DIR
holds its manifest.json and stubs/), one line each:

    <40 hex: the stub's cdhash>  <40 hex: the arm64 slice's cdhash>  <arch>  <path under ROOT>

A stub is listed only if the arm slice its signed __TEXT,__hao_slice record
names is the arm64 slice of ROOT/path and that cdhash is in TRUSTED (the list
above, so `anchor apple`). The stub's cdhash is the one the kernel reports for
the running program. hao-image-payload installs the list as
usr/lib/hao/stub-identities, read under the same ownership rules (the format
of include/hao/idlist.h, shared with native-identities): it says which x86_64
stubs run which Apple program (docs/security-model.md, Identity).
"""
import concurrent.futures
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import plistlib
import struct
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import hao_fat  # noqa: E402

_spec = importlib.util.spec_from_loader("hao_embed", importlib.machinery.SourceFileLoader("hao_embed", os.path.join(HERE, "hao-embed")))
hao_embed = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(hao_embed)

LC_CODE_SIGNATURE = 0x1D
CSMAGIC_EMBEDDED_SIGNATURE = 0xFADE0CC0
CSMAGIC_CODEDIRECTORY = 0xFADE0C02
RANK = {1: 1, 3: 2, 2: 3, 4: 4}                      # xnu hashPriorities
HASH = {1: hashlib.sha1, 2: hashlib.sha256, 3: hashlib.sha256, 4: hashlib.sha384}


def slice_and_arch(data):
    """(arm64 slice bytes, codesign --arch name) of the slice hao runs."""
    best, rank, arch = None, 0, None
    for c, sub, payload in hao_fat.slices(data) or []:
        if c != hao_fat.CPU_ARM64:
            continue
        caps = sub & 0xFF000000
        r = (3 if caps in (0, 0x80000000) else 2) if sub & 0x00FFFFFF == 2 else 1
        if r > rank:
            best, rank, arch = payload, r, "arm64e" if sub & 0x00FFFFFF == 2 else "arm64"
    return best, arch


def cdhash(macho):
    """The xnu cdhash (hex) of a thin arm64 Mach-O, or None if unsigned."""
    sig = None
    for cmd, off, _ in hao_embed.load_commands(macho):
        if cmd == LC_CODE_SIGNATURE:
            dataoff, datasize = struct.unpack_from("<II", macho, off + 8)
            sig = macho[dataoff:dataoff + datasize]
    if sig is None:
        return None
    magic, length, count = struct.unpack_from(">III", sig, 0)
    if magic != CSMAGIC_EMBEDDED_SIGNATURE:
        raise ValueError("not an embedded signature")
    best = None
    for k in range(count):
        typ, off = struct.unpack_from(">II", sig, 12 + 8 * k)
        if typ == 0 or 0x1000 <= typ < 0x1005:
            m, ln = struct.unpack_from(">II", sig, off)
            if m != CSMAGIC_CODEDIRECTORY:
                raise ValueError("bad CodeDirectory magic")
            ht = sig[off + 37]
            if ht not in RANK:
                raise ValueError("hash type %d" % ht)
            if best is None or RANK[ht] > best[0]:
                best = (RANK[ht], ht, sig[off:off + ln])
    if best is None:
        raise ValueError("no CodeDirectory")
    return HASH[best[1]](best[2]).hexdigest()[:40]


MH_DYLIB, MH_BUNDLE = 6, 8


def guest_library(data):
    """An arm64-only dylib or bundle: hao loads it as a guest image."""
    sl = hao_fat.slices(data)
    if not sl or any(c == hao_fat.CPU_X86_64 for c, _, _ in sl):
        return False
    mo, _ = slice_and_arch(data)
    return mo is not None and len(mo) >= 32 and int.from_bytes(mo[12:16], "little") in (MH_DYLIB, MH_BUNDLE)


def scan(root):
    """Every arm64-only LC_MAIN executable under ROOT, as tools/hao-embed --scan
    finds them but whatever their mode bits (an unpacked tree may have lost
    them; the installed image has them), and every arm64-only dylib or bundle."""
    seen, found = set(), []
    for base, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(base, d))]
        for name in files:
            path = os.path.join(base, name)
            try:
                st = os.lstat(path)
                if not os.path.isfile(path) or os.path.islink(path) or st.st_size < 4096 or (st.st_dev, st.st_ino) in seen:
                    continue
                with open(path, "rb") as f:
                    if f.read(4) not in (b"\xcf\xfa\xed\xfe", b"\xca\xfe\xba\xbe", b"\xca\xfe\xba\xbf"):
                        continue
                seen.add((st.st_dev, st.st_ino))
                data = open(path, "rb").read()
                if hao_embed.executable_arm_only(data) is None or guest_library(data):
                    found.append(path)
            except OSError:
                continue
    return sorted(found)


def verdict(root, path):
    """(cdhash, relpath, None) if PATH is listed, else (None, relpath, why)."""
    rel = os.path.relpath(os.path.realpath(path), root)
    try:
        data = open(path, "rb").read()
        mo, arch = slice_and_arch(data)
        if mo is None:
            return None, rel, "no arm64 slice"
        h = cdhash(mo)
        if h is None:
            return None, rel, "not signed"
    except (OSError, ValueError, struct.error) as e:
        return None, rel, str(e)
    r = subprocess.run(["codesign", "--verify", "--strict", "--ignore-resources", "-R=anchor apple", "--arch", arch, path],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None, rel, (r.stderr.strip().splitlines() or ["codesign exit %d" % r.returncode])[-1]
    return h, rel, None


LC_SEGMENT_64 = 0x19
SLICE_SECTION = (b"__TEXT", b"__hao_slice")


def section(macho, segname, sectname):
    """The bytes of a thin 64-bit Mach-O's section, or None."""
    for cmd, off, _ in hao_embed.load_commands(macho):
        if cmd != LC_SEGMENT_64 or macho[off + 8:off + 24].rstrip(b"\0") != segname:
            continue
        nsects = struct.unpack_from("<I", macho, off + 64)[0]
        for k in range(nsects):
            s = off + 72 + 80 * k
            if macho[s:s + 16].rstrip(b"\0") == sectname:
                size, fileoff = struct.unpack_from("<QI", macho, s + 40)
                return macho[fileoff:fileoff + size]
    return None


def stub_identities(embed, trusted_path, root):
    """[(stub cdhash, arm cdhash, arch, path)] for the stubs of EMBED whose named arm slice is trusted."""
    trusted = {l.split()[0].lower() for l in open(trusted_path) if l.strip() and not l.startswith("#")}
    manifest = json.load(open(os.path.join(embed, "manifest.json")))
    out, why = [], []
    for e in manifest["files"]:
        path = e["path"]
        try:
            stub = open(os.path.join(embed, e["stub"]), "rb").read()
            rec = section(stub, *SLICE_SECTION)
            if rec is None or len(rec) != 32 or rec[:8] != hao_embed.SLICE_MAGIC or rec[8] != 1:
                why.append((path, "the stub has no __hao_slice record v1"))
                continue
            named = rec[12:32].hex()
            mo, arch = slice_and_arch(open(os.path.join(root, path), "rb").read())
            if mo is None or cdhash(mo) != named:
                why.append((path, "the stub's __hao_slice does not name the program's arm64 slice"))
                continue
            if named not in trusted:
                why.append((path, "arm64 slice not in the trusted list"))
                continue
            sh = cdhash(stub)
            if sh is None:
                why.append((path, "the stub is not signed"))
                continue
            out.append((sh, named, arch, path))
        except (OSError, ValueError, KeyError, struct.error) as ex:
            why.append((path, str(ex)))
    return sorted(out), why


def main():
    a = sys.argv[1:]
    if a and a[0] == "--stubs":
        if len(a) != 4:
            sys.exit(__doc__.split("\n\n")[0])
        ok, why = stub_identities(a[1], a[2], os.path.realpath(a[3]))
        print("# hao stub identities v1: %d stubs (stub cdhash, Apple arm64 slice cdhash, arch, path)" % len(ok))
        for s, h, ar, p in ok:
            print("%s  %s  %s  %s" % (s, h, ar, p))
        for p, w in why:
            print("hao-trust-list: stub not listed: %s: %s" % (p, w), file=sys.stderr)
        return 0
    if a and a[0] == "--cdhash":
        for p in a[1:]:
            mo, _ = slice_and_arch(open(p, "rb").read())
            print(cdhash(mo) if mo is not None else "-", p)
        return 0
    if len(a) not in (1, 2) or a[0].startswith("-"):
        sys.exit(__doc__.split("\n\n")[0])
    root = os.path.realpath(a[0])
    if len(a) == 2:
        progs = [l.strip() for l in open(a[1]) if l.strip() and not l.lstrip().startswith("#")]
        progs = [p if os.path.isabs(p) else os.path.join(root, p) for p in progs]
    else:
        progs = scan(root)
    with concurrent.futures.ThreadPoolExecutor(max_workers=os.cpu_count() or 4) as ex:
        res = list(ex.map(lambda p: verdict(root, p), progs))
    try:
        v = plistlib.load(open(os.path.join(root, "System/Library/CoreServices/SystemVersion.plist"), "rb"))
        rel = "%s %s" % (v["ProductVersion"], v["ProductBuildVersion"])
    except (OSError, KeyError, plistlib.InvalidFileException):
        rel = "unknown release"
    ok = sorted((h, r) for h, r, why in res if h)
    print("# hao trusted cdhashes v1: %s, %d of %d programs and guest libraries (anchor apple, arm64 slice hao runs)" % (rel, len(ok), len(res)))
    for h, r in ok:
        print("%s  %s" % (h, r))
    for h, r, why in res:
        if not h:
            print("hao-trust-list: not listed: %s: %s" % (r, why), file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
